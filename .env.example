# ==============================
# Service URLs (set automatically by docker-compose; override for local dev)
# ==============================
API_BASE_URL=http://botc:8000
TELEGRAM_SERVICE_URL=http://telegram:8001

# ==============================
# Required credentials
# ==============================
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret
TELEGRAM_ENABLED=true
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_USER_ID=your_telegram_user_id

# API_SECRET_TOKEN protects all REST endpoints and the /notify webhook.
# Both botc and telegram read this from the same .env.
# If unset, the app refuses to start unless ALLOW_NO_AUTH=true is also set.
API_SECRET_TOKEN=your_api_secret_token
# Explicit opt-in to run the API without authentication (development only).
ALLOW_NO_AUTH=false

# Maximum concurrent optimizer jobs. 0 disables the optimizer entirely (POST
# /optimizer/jobs returns 503). ≥1 allows up to N jobs in flight (409 when all
# slots are busy). On a resource-constrained host (e.g. a free-tier micro VM)
# set to 0 to prevent the CPU-bound search from starving the trading engine.
# Each AUTO job spawns ~2 extra worker processes; keep this low on small hosts.
MAX_CONCURRENT_JOBS=1
# Consecutive failed sessions before one Telegram alert (with a recovery message
# on the next success). Also gates the session-overrun early-warning: the same
# count of consecutive sessions that ran longer than SLEEPING_INTERVAL (long
# enough to skip the next tick) triggers one "host may be resource-starved" alert.
SESSION_FAILURE_ALERT_THRESHOLD=3

# ==============================
# Database settings
# ==============================
POSTGRES_DB=DBbotc
POSTGRES_USER=botc
POSTGRES_PASSWORD=change_me_with_a_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==============================
# Core bot settings
# ==============================
PAIRS=XBTEUR,ETHEUR
# Master trading switch. Leave true in production. Set to false to run a
# non-trading replica that still ingests OHLC, calibrates, records sessions and
# serves the API/optimizer but never opens or manages positions (e.g. a local
# stack used to run the optimizer with full features).
TRADING_ENABLED=true
SLEEPING_INTERVAL=60
PARAM_SESSIONS=720
CANDLE_TIMEFRAME=15
ATR_PERIOD=14
ATR_DESV_LIMIT=0.2
MIN_VALUE=10
TELEGRAM_POLL_INTERVAL=10
MINIMUM_CHANGE_PCT=0.02

# ==============================
# Pair allocation and behavior
# Use one block per pair listed in PAIRS
# ==============================
# Activation uses ONE of two branches: K_ACT * ATR when K_ACT is set, else
# K_STOP * ATR + MIN_MARGIN * price. Leave K_ACT empty to run the MIN_MARGIN
# branch, which is the one the validation study found a profitable region in —
# the K_ACT branch won none of its twelve hold-out fits.
# MIN_MARGIN 0.05 is the middle of the characterised region: below 0.01 a config
# sits at percentile 0-2 in every period, above 0.15 it barely trades. Inside the
# region the choice is indistinguishable from chance, so it is settled on
# operational grounds (operation count, fees, time out of the asset).
# STOP_PCT 0.90 is the validated ceiling; 1.0 is a sample maximum, not a
# percentile. There is no measured per-operation edge, so each extra operation is
# only fee — the widest valid stop trades least.
# See docs/specs/optimizer-validation-design.md.
XBTEUR_TARGET_PCT=50
XBTEUR_HODL_PCT=25
XBTEUR_K_ACT=
XBTEUR_MIN_MARGIN=0.05
XBTEUR_STOP_PCT_LL=0.90
XBTEUR_STOP_PCT_LV=0.90
XBTEUR_STOP_PCT_MV=0.90
XBTEUR_STOP_PCT_HV=0.90
XBTEUR_STOP_PCT_HH=0.90

ETHEUR_TARGET_PCT=50
ETHEUR_HODL_PCT=25
ETHEUR_K_ACT=
ETHEUR_MIN_MARGIN=0.05
ETHEUR_STOP_PCT_LL=0.90
ETHEUR_STOP_PCT_LV=0.90
ETHEUR_STOP_PCT_MV=0.90
ETHEUR_STOP_PCT_HV=0.90
ETHEUR_STOP_PCT_HH=0.90

# ==============================
# Grafana
# ==============================
# Password for the read-only Postgres role used by Grafana panels.
# Consumed by both the Alembic migration (`grafana_reader` creation) and the
# grafana service's datasource provisioning.
GRAFANA_DB_PASSWORD=change_me_with_a_strong_password

# Admin login for the Grafana UI. First-boot only — Grafana stores the
# bcrypt'd password in its volume after that.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_with_a_strong_password
